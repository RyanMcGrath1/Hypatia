# Local Expo client config (copy to `.env` — that file is gitignored).
# EXPO_PUBLIC_* values are bundled into the client and are not secrets.

# Hypatia API base (optional). Prefer LAN IP on devices; web may use Metro proxy.
# EXPO_PUBLIC_HYPATIA_BASE_URL=http://127.0.0.1:5001

# Development-only frontend UI bypass (NOT authentication).
# Only active when Expo/React Native __DEV__ is true AND this is exactly "true".
# Production builds cannot enable this even if set to true.
# Does not create a backend Session; protected API routes still require a real token.
EXPO_PUBLIC_DEV_AUTH_BYPASS=false
